{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Kiro Token Manager",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.kiro.token-manager",
      "targets": "all"
    },
    "security": {
      "csp": null,
      "dangerousRemoteDomainIpcAccess": [
        {
          "domain": "app.kiro.dev",
          "windows": ["auth"],
          "enableTauriAPI": true
        }
      ]
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "cli": {
      "description": "Kiro Token Manager CLI",
      "args": [
        {
          "short": "c",
          "name": "config",
          "description": "Path to config file",
          "takesValue": true
        }
      ]
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 700,
        "resizable": true,
        "title": "Kiro Token Manager",
        "width": 1100,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "callback",
        "url": "/callback",
        "title": "登录回调",
        "width": 500,
        "height": 600,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ]
  }
}
